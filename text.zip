    "Gem", "gem", "Chest", "chest", "Crate", "crate", "Box", "box",
    "Flower", "flower", "Bush", "bush", "Mushroom", "mushroom",
    "Fish", "fish", "Monster", "Enemy", "Mob", "mob",
    "Coin", "coin", "Money", "money", "Cash", "cash",
    
    -- SIMULATOR SPECIFIC
    "Dirt", "Grass", "Sand", "Gravel", "Obsidian",
    "Emerald", "Ruby", "Sapphire", "Amethyst", "Topaz",
    "Mythic", "Legendary", "Epic", "Rare", "Common",
    
    -- ANIME GAMES
    "Quest", "Boss", "Minion", "Spawn",
    
